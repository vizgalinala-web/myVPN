<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MyVPN.Client.App.MainWindow"
        Title="MyVPN"
        Width="440" Height="580"
        MinWidth="360" MinHeight="480"
        WindowStartupLocation="CenterScreen">
  <ScrollViewer Padding="20">
    <StackPanel Spacing="12">
      <TextBlock FontSize="22" FontWeight="SemiBold" Text="MyVPN" />
      <TextBlock Opacity="0.8" TextWrapping="Wrap"
                 Text="Windows client. Keys stay on this PC. The tunnel uses WireGuard for Windows when it is installed." />

      <TextBlock Text="API URL" />
      <TextBox x:Name="ApiBox" Watermark="http://127.0.0.1:5212/" />

      <TextBlock Text="Email" />
      <TextBox x:Name="EmailBox" Watermark="you@example.com" />

      <TextBlock Text="Password" />
      <TextBox x:Name="PasswordBox" PasswordChar="•" Watermark="Not saved on disk" />

      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button x:Name="ConnectButton" Content="Connect" MinWidth="120" Click="OnConnect" />
        <Button x:Name="StopButton" Content="Stop" MinWidth="120" Click="OnStop" />
      </StackPanel>

      <TextBlock FontWeight="SemiBold" Text="Status" />
      <TextBlock x:Name="StatusBlock" TextWrapping="Wrap" />
      <TextBlock x:Name="HintBlock" Opacity="0.75" TextWrapping="Wrap" />
    </StackPanel>
  </ScrollViewer>
</Window>
