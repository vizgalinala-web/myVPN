# Development placeholders only. Copy to .env and adjust locally. Never commit real secrets.
POSTGRES_USER=myvpn
POSTGRES_PASSWORD=myvpn_dev_password
POSTGRES_DB=myvpn
POSTGRES_PORT=5432

ConnectionStrings__Default=Host=postgres;Port=5432;Database=myvpn;Username=myvpn;Password=myvpn_dev_password
Jwt__Issuer=myvpn-api
Jwt__Audience=myvpn-clients
Jwt__SigningKey=DEV_ONLY_CHANGE_ME_32chars_min_key!!
Jwt__AccessTokenLifetimeMinutes=15
RefreshTokens__LifetimeDays=30
RefreshTokens__HashPepper=DEV_ONLY_REFRESH_PEPPER_CHANGE_ME_32
Cors__AllowedOrigins__0=http://localhost:3000
Vpn__DnsServers=1.1.1.1
Vpn__AllowedIps=0.0.0.0/0, ::/0
Vpn__PersistentKeepaliveSeconds=25
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:8080
